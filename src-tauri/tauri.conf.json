{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraPilot",
  "version": "0.1.0",
  "identifier": "dev.aurapilot.desktop",
  "build": {
    "beforeDevCommand": "node scripts/start-tauri-web.mjs",
    "beforeBuildCommand": "pnpm --dir web build",
    "devUrl": "http://localhost:28727",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraPilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local task control plane for coding agents",
    "longDescription": "AuraPilot manages repository task protocols and hands selected tasks to user-configured coding agent launch profiles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
